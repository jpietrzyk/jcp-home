---
id: slou
title: Slou
description: S l o u u u
bpm: 53
tags:
  - fast
  - breakbeat
  - slow
  - downtempo
---

// Import samples from GitHub repository
samples('github:eddyflux/crate');
samples('github:yaxu/clean-breaks');

/*
  ### Track tempo ### ---
  In BPM (beats per minute && 4 beats per cycle)
 */
const bpm = 60; // 53 original
setCps(bpm/40/4);

//
// *** Slow drums ***
//

// // slow beat with accents
const patSloKicks = `<
  [[crate_bd:0 ~ crate_bd:0 ~ crate_bd:0 ~ ~ crate_bd:0]!7]@14
  [crate_bd:0 ~ [crate_bd:0 ~ ~ crate_bd:0] [~ crate_bd:0]]>`;
const patSloSnares = "<[~ ~ d70_sd:5 ~]!15 [~ crate_rim:5 crate_cr:3 [crate_oh:4 hh hh hh]]>"

const sloDrums = stack(
  s(patSloKicks).gain("<[1 1 1 1 .5 .8 .8 .8]!14 [.7 .5]>").lpf("2700").lpq("4").delay(".05"),
  s(patSloSnares).gain("<[.8]!15 [.9 .6 .1 [.4 .2 .3]]>").lpf("1600").lpq("2").delay(".2")
)

const patSloKicks2 = `<[[bd ~ ~ bd bd ~ bd ~] [bd bd ~ bd ~ bd ~ bd] [bd bd ~ ~ bd ~ bd ~] [bd ~ ~ bd ~ bd ~ bd]]/4>`;
const patSloSnares2 = `<[~ ~ d70_sd:5 ~]!15 [~ crate_rim:5 crate_cr:3 [crate_oh:4 hh hh hh]]>`

const sloDrums2 = stack(
  s(patSloKicks2).bank("crate").gain("<[1 .8]!15 [.9 .6 .1 [.4 .2 .3]]>").lpf("2700").lpq("2").delay(".05"),
  s(patSloSnares2).gain("<[1 .9]!7 [.9 .6 .1 [.4 .2 .3]]>").lpf("1600").lpq("4").delay(".2")
).room(".1");

//
// *** Uni drums ***
//

const patRides = "<[alesissr16_rd ~ dmx_rd ~ alesissr16_rd ~ mpc60_rd ~]>";
const patCrashes = "<[bossdr220_cr bossdr220_cr bossdr220_cr bossdr220_cr]>"

const splashes = stack(
  s(patRides).clip(4).gain(`<[.1 .2 .1 .15]>`).room("<[0 1 0 0]>").delay("<[0 .4 0 .4]>"),
  s(patCrashes).clip(1).gain(`<[.05 .05 .05 .05]>`).delay("<[0 .1 0 .1]>")
);

const sloHatz = s("<[hh*4]!3 [hh hh oh ~]>").bank("crate")
  .gain(.5)
  .lpf(1300).lpq(2)
  .room(.5).delay(.3);

// soft rhytm
const stckSoftyDrums = stack(
  s("[[oh [hh hh]] [oh [hh hh]] [~ hh hh hh] oh [~ [oh hh]] [oh [~ hh]] [hh hh oh@2] xr10_cr:1]/2")
  .gain("[[.2 [.3 .3]] .4 .5 [.2 [.3 .3]] .4 .2]/2")
  .lpf(1200).room(.1).delay(".2 .15"),
  s("<[~] [~] [~] [~ ~ ~ cr]>").gain("<[~] [~] [~] [.03]>"),
  s("<[alesishr16_rim:0 ~ alesissr16_rd ~] [alesishr16_rim:0 ~ alesissr16_rd ~] [alesishr16_rim:0 ~ alesishr16_rim:0 alesissr16_perc] [alesishr16_rim:0 ~ alesishr16_rim:0 alesissr16_perc]>")
    .gain("<[.2 .25 .07 .1]!2 [.05 .25 .2 .1] [.15 .2 .2 .1]>")
    .room(.1).delay(.2).postgain(".2")
);

//
// *** Fast drums ***
//

const fastSnares = `<
  [~ d70_sd:5 ~ d70_sd:5]!7 [~ d70_sd:5 d70_sd:5 ~] [~ d70_sd:5 ~ d70_sd:5]!7 [~ ~ ~ ~]
>*2`;

const fastDrums = `<
    [
     [[crate_bd:0 crate_bd:0 ~ ~] [crate_bd:0 ~ ~ ~]]
     [[crate_bd:0 crate_bd:0 ~ crate_bd:0] [crate_bd:0 ~ ~ ~]]
    ]!15
    [
      [crate_bd:0 crate_bd:0 ~ crate_bd:0]
      [~ crate_rim:5 crate_cr:3 crate_oh:4]
    ]
>`;

// fast kickcs and passes
const patFastDrums = s(fastDrums).gain("<[[.9 .6 .6 .3] [1 1 .4 1]]!15 [[1 1 ~ 1] [1 .4 .4 .2]]>")
  .lpf("<[2700]>").lpq("<[8]>")
  .room("<[0]!15 [0 0 .4 .4]>").delay("<[0]!15 [0 0 .1 .2]>");

// fast snares
const patFastSnares = s(fastSnares).gain("<[1 .8]>*2").lpf("<[~ 1400 ~ 1600]!13 [1200 1400] [1000 1000] [800 1300]>*2").lpq("<[~ 2 ~ 4]>*2")
  .room("<[.1 .05]>*2").delay("<[.1 0]>*2");

// fast hats
const stckFastHats = stack(
  s("[hh]*32").bank("bossdr110").gain("[[.4 .2 .6 .1]*2 [.4 .2 .6 .1]*2 [.4 .2 .5 .1]*2 [.6 .2 .5 .2]*2]").delay(".2").room(.6).attack(.05),
  s("[[~ ~ rd ~] [cr oh] [~ ~ rd ~] [cr rd cr ~]]").bank("bossdr110").gain("[.15] [.1] [.2] [.1]").room(.1).delay(.2)
);

//
// *** Electric guitars ***
//

// ### Lead melody
const patDelayedGuitarMelody = n("<0 0 5 [4 2] 0 0 7 [6] 4 4 5 [4 2] 0 ~ 3 [[10] ~ [11] ~]>*2").scale("C:minor").clip(2).s("gm_electric_guitar_clean:2, gm_electric_guitar_clean:0:.05")
  .gain("<[.2 .15] .2 [.1 .2] .15 [.2 .15] [.25 .2] .1 [.15 .2]>")
  .room(.5).delay(.5)
  .lpf(900)
  .postgain(.6);

// bouncing arpy
const patDelayedGuitarHiArp = n("<[11 ~ 14 ~] [11 ~ 10 9] [11 ~ 14 ~] [11 ~ 14 ~] [12 ~ 14 ~] [12 ~ 12 11] [12 ~ 14 ~] [16 ~ 12 ~]>*4")
  .scale("C:minor").clip(2).s("gm_electric_guitar_jazz:8")
  .gain("<[.2 .15] [.2 .1] [.1 .2] [.15 .1] [.2 .15] [.25 .1] [.1 .2] [.15 .2]>")
  .delay(.8);

// Muted guitar
const patMutedGuitarRythm = n("<[0!2 ~ 0!3 ~ 0] [0!2 ~ 0!3 ~ -1] [0!2 ~ 0!3 ~ 0] [2 0 ~ ~ ~ 2 1 0]>")
  .scale("C:minor").clip(2).s("gm_electric_guitar_muted:0").gain("<[.6 .8] [.6 .8] [.6 .8] [.6 .5]>")
  .adsr("0:.3:0:0")
  .delay("<[.8 .3 .5 .3] [.8 .3 .5 .3] [.8 .3 .5 .3] [.8 .3 .5 .3]>");

//
// *** Acoustic gutiar ***
//

// Chords
const patNylonGuitarChords = n("<11 11 ~ 9, 7!4>").scale("C:minor").s("gm_acoustic_guitar_nylon:0")
  .gain("<.2 .15 .3 .2>").attack(.01).room(1).delay(.3);

// TODO: Vary delay
// Soft nylon guitar
const patNylonGuitarLead = n("<[~ 7 ~ 10 ~ 10 ~ [10 9]]!2 [~ 7 ~ 9 ~ 10 ~ [9 7]] [~ 7 ~ 7 ~ 7@2 ~]>")
  .scale("C:minor").s("gm_acoustic_guitar_nylon:0").delay(.4).room(.2)
  .hpf(800).hpq(5);

//
// *** Keys ***
//

// Electric Piano arp
const patEPianoArp = n("<[[4 0 7 0] [4 0 7 2]]*2 [[5 0 7 5]!2 [5 0 7 4] [5 0 9 6]]>").scale("C:minor").clip(2).s("gm_epiano1");

// Lo piano
const stckLoPiano = stack(
  n("<14!3  [19 21] 14!2 21 [19 18]>").scale("C:minor").s("piano").lpf("<500 [900 800]>").lpq("<1 [3 2]>").room(.3).delay("<.5 [.3 .1]>"),
  n("<0@3 [5 4] 0 ~ ~ -2>").scale("C:minor").s("piano:2").gain(".3").lpf("<500>").room(.7).delay("<.1>")
);

// Hi piano
const patHiPiano = n("<21 [21 20] 21 [26 25] 21 [21 20] 21 [26 [~ 25 25 25]]>").scale("C:minor").s("piano:0")
  .room(.8)
  .gain("<.4 .3 .2 [.2 .4 .2 .5] .2 .2 .3 [.3 .4 .2 .6]>");

//
// *** Pads ***
//

// pad stack
const stckPad = stack(
  n("<-7@3 [-5 -5]>").gain("1"),
  n("<-10@3 [-3 -7]>").gain(".7"),
  n(" <3@3 [5 0]>").gain(".2"),
  n(" <7@3 [0 0]>").gain(".4")
).scale("C:minor").s("gm_pad_choir:5");

//
// *** Basses ***
///

// Bass
const patBassPad = n("<[-7@4] [-10@2 -8@2] [-7@3 -7] [-10@3 -8]>")
  .scale("C:minor").s("gm_kalimba")
  .adsr(".5:2:2:1").gain("<[1]>")
  .lpf(3200);

// ### Sub bass
// TODO: Make more complicated pattern
const patSubBass = note("<21 [26 ~] 21 [26 25] 21 [26 ~] [21 28] [26 25]>").s("sine:0:1, sine:1:.7")
  .gain("<.9 [.7 .9]>").adsr(".5:.7:.05:.0").vib("<[2:2 2:4] [3:2 5:8]>")
  .room("<.2, .5>");

// *** *** *** *** ***
// *** *** playing patterns *** ***
// ***

// simplest drums
_$: sloDrums.postgain(.4);
// simple drums but a lil bit complicated
_$: sloDrums2.postgain(.4);

// splash play to make it more groovy
$: splashes.postgain(".05")
// reverbed hats
$: sloHatz.postgain(.3);
// groovy soft drums
$: stckSoftyDrums

// fast kicks
$: patFastDrums.postgain(.7);
// fast snares
$: patFastSnares.postgain(.5);
// fast hats
$: stckFastHats.postgain(.1);

// basic melody electric guitar
$: patDelayedGuitarMelody.postgain(.6);
// nice reverbed arp
$: patDelayedGuitarHiArp.postgain(.6);
// rythm muted electric guitar
$: patMutedGuitarRythm.postgain(".6");

// nylon guitar soft chords
_$: patNylonGuitarChords.postgain(.6);
// nylon reverbed guitar fast lead
$: patNylonGuitarLead.postgain(slider(0.9, .1, 1.5, .1));

// electric piano arp
$: patEPianoArp.lpf(slider(200, 200, 1200, 50)).lpq(5).postgain(.5);

// soft reverbed lo piano
$: stckLoPiano.postgain(.6);
// soft reverbed hi piano
$: patHiPiano.postgain(.6);

// lo choir pads
$: stckPad.postgain(.05);

// bass 1
$: patBassPad.postgain(.8);
// sub bass
_$: patSubBass.postgain(.6);

